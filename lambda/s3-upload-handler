def get_all_subscriptions():
    """
    Read all user notification preferences from DynamoDB.
    Handles pagination in case the table grows.
    """
    items = []
    scan_kwargs = {}

    while True:
        response = subscriptions_table.scan(**scan_kwargs)
        items.extend(response.get("Items", []))

        last_key = response.get("LastEvaluatedKey")
        if not last_key:
            break

        scan_kwargs["ExclusiveStartKey"] = last_key

    return items


def get_matching_subscriptions(tags):
    """
    Match Oracle-detected species tags against user watched tags stored in DynamoDB.
    """
    try:
        detected_tag_set = set(normalise_tag(tag) for tag in tags.keys())

        print("Detected tag set for subscription matching:")
        print(json.dumps(list(detected_tag_set), indent=2))

        items = get_all_subscriptions()

        matched_subscriptions = []

        for item in items:
            user_email = item.get("user_email")
            subscribed_tags = item.get("subscribed_tags", [])

            subscribed_tag_set = set(
                normalise_tag(tag)
                for tag in subscribed_tags
                if normalise_tag(tag)
            )

            matched_tags = sorted(list(detected_tag_set.intersection(subscribed_tag_set)))

            if user_email and matched_tags:
                matched_subscriptions.append({
                    "user_email": user_email,
                    "matched_tags": matched_tags
                })

        print("Matched notification subscriptions:")
        print(json.dumps(matched_subscriptions, indent=2, default=str))

        return matched_subscriptions

    except Exception as e:
        print(f"Error reading notification subscriptions: {str(e)}")
        return []


def send_tag_notification(file_name, file_type, tags, confidence, file_url, thumbnail_url, frames_processed):
    """
    Send SNS notifications when detected tags match saved user tag preferences.

    Important:
    - DynamoDB stores user watched tags.
    - SNS subscription filter policy controls which confirmed email receives the message.
    - Each matched species tag is published as a separate SNS message with MessageAttributes.
    """
    matched_subscriptions = get_matching_subscriptions(tags)

    if not matched_subscriptions:
        print("No user subscribed tags matched. SNS notification not sent.")
        return False

    notification_results = []

    for subscription in matched_subscriptions:
        user_email = subscription.get("user_email")
        matched_tags = subscription.get("matched_tags", [])

        for matched_tag in matched_tags:
            subject = f"AussieEcoLens Alert: {matched_tag}"

            message = {
                "message": "New media matched your watched wildlife tag.",
                "matched_user_email": user_email,
                "matched_tag": matched_tag,
                "file_name": file_name,
                "file_type": file_type,
                "all_detected_tags": tags,
                "confidence": confidence,
                "frames_processed": frames_processed,
                "file_url": file_url,
                "thumbnail_url": thumbnail_url,
                "note": "This notification was generated based on saved user tag preferences and delivered using SNS filter policy."
            }

            try:
                response = sns.publish(
                    TopicArn=SNS_TOPIC_ARN,
                    Subject=subject,
                    Message=json.dumps(message, indent=2, default=str),
                    MessageAttributes={
                        "species_tag": {
                            "DataType": "String",
                            "StringValue": matched_tag
                        }
                    }
                )

                print(f"SNS notification published for {user_email} with species_tag={matched_tag}")
                print(json.dumps(response, indent=2, default=str))

                notification_results.append({
                    "user_email": user_email,
                    "matched_tag": matched_tag,
                    "status": "published_to_sns"
                })

            except Exception as e:
                print(f"SNS notification failed for {user_email}, tag={matched_tag}: {str(e)}")

                notification_results.append({
                    "user_email": user_email,
                    "matched_tag": matched_tag,
                    "status": "failed",
                    "error": str(e)
                })

    print("Notification results:")
    print(json.dumps(notification_results, indent=2, default=str))

    return any(result["status"] == "published_to_sns" for result in notification_results)


def lambda_handler(event, context):
    print("Received event:")
    print(json.dumps(event, indent=2))

    results = []

    for record in event.get("Records", []):
        bucket_name = record["s3"]["bucket"]["name"]
        object_key = urllib.parse.unquote_plus(record["s3"]["object"]["key"])

        if not object_key.startswith("uploads/"):
            print(f"Skipped non-upload object: {object_key}")
            continue

        file_name = object_key.split("/")[-1]
        file_extension = file_name.split(".")[-1].lower() if "." in file_name else ""

        if file_extension in ["jpg", "jpeg", "png"]:
            file_type = "image"
        elif file_extension in ["mp4", "mov", "avi"]:
            file_type = "video"
        else:
            file_type = "unknown"

        file_response = s3.get_object(Bucket=bucket_name, Key=object_key)
        file_bytes = file_response["Body"].read()

        checksum = calculate_sha256(file_bytes)
        print(f"Checksum for {object_key}: {checksum}")

        duplicate_check = media_table.scan(
            FilterExpression=Attr("checksum").eq(checksum)
        )

        existing_items = duplicate_check.get("Items", [])

        if existing_items:
            print("Duplicate file detected.")
            print(json.dumps(existing_items, indent=2, default=str))

            s3.delete_object(Bucket=bucket_name, Key=object_key)
            print(f"Deleted duplicate object from S3: {object_key}")

            results.append({
                "file_name": file_name,
                "status": "duplicate_deleted",
                "checksum": checksum
            })

            continue

        file_id = str(uuid.uuid4())
        thumbnail_url = ""

        if file_type == "image":
            thumbnail_key = create_thumbnail(
                bucket_name,
                object_key,
                file_name,
                file_bytes
            )
            thumbnail_url = f"s3://{bucket_name}/{thumbnail_key}"

        tags = {}
        confidence = {}
        frames_processed = 0
        ml_source = ""

        if file_type == "image":
            tags, confidence, ml_source = call_oracle_species_detector(
                file_name,
                file_type,
                file_bytes
            )

        elif file_type == "video":
            tags, confidence, frames_processed, ml_source = call_oracle_video_detector(
                file_name,
                file_type,
                file_bytes
            )

        else:
            tags = generate_basic_tags(file_name)
            ml_source = "fallback_basic_tags"

        file_url = f"s3://{bucket_name}/{object_key}"

        item = {
            "file_id": file_id,
            "bucket": bucket_name,
            "s3_key": object_key,
            "file_name": file_name,
            "file_type": file_type,
            "file_url": file_url,
            "thumbnail_url": thumbnail_url,
            "tags": tags,
            "confidence": confidence,
            "frames_processed": frames_processed,
            "ml_source": ml_source,
            "checksum": checksum,
            "created_at": datetime.now(timezone.utc).isoformat()
        }

        item = convert_floats_to_decimal(item)

        media_table.put_item(Item=item)

        print("Inserted new item into DynamoDB:")
        print(json.dumps(item, indent=2, default=str))

        notification_sent = send_tag_notification(
            file_name=file_name,
            file_type=file_type,
            tags=tags,
            confidence=confidence,
            file_url=item.get("file_url"),
            thumbnail_url=item.get("thumbnail_url"),
            frames_processed=frames_processed
        )

        results.append({
            "file_name": file_name,
            "file_type": file_type,
            "status": "inserted_with_thumbnail" if file_type == "image" else "inserted",
            "checksum": checksum,
            "thumbnail_url": thumbnail_url,
            "tags": tags,
            "confidence": confidence,
            "frames_processed": frames_processed,
            "ml_source": ml_source,
            "notification_sent": notification_sent
        })

    return {
        "statusCode": 200,
        "body": json.dumps({
            "message": "S3 upload event processed with checksum deduplication, thumbnail generation, Oracle ML detection, DynamoDB metadata storage, user tag matching, and SNS filter-policy notification",
            "results": results
        }, default=str)
    }
