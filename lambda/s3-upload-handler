import json
import urllib.parse
import boto3
import uuid
import hashlib
import re
import base64
import urllib.request
from datetime import datetime, timezone
from decimal import Decimal
from boto3.dynamodb.conditions import Attr
from PIL import Image
from io import BytesIO

s3 = boto3.client("s3")
dynamodb = boto3.resource("dynamodb")
sns = boto3.client("sns")

# Main media metadata table
media_table = dynamodb.Table("AussieEcoLensMedia")

# User notification preferences table
subscriptions_table = dynamodb.Table("AussieEcoLensSubscriptions")

SNS_TOPIC_ARN = "arn:aws:sns:ap-southeast-2:656260749390:AussieEcoLensTagNotifications"

ORACLE_DETECT_URL = "http://169.224.229.232:8080/detect"
ORACLE_VIDEO_DETECT_URL = "http://169.224.229.232:8080/detect-video"
ORACLE_ANNOTATE_URL = "http://169.224.229.232:8080/annotate"


def calculate_sha256(file_bytes):
    return hashlib.sha256(file_bytes).hexdigest()


def normalise_tag(tag):
    return str(tag or "").strip().lower().replace(" ", "_")


def create_thumbnail(bucket_name, object_key, file_name, image_bytes):
    image = Image.open(BytesIO(image_bytes))
    image.thumbnail((200, 200))

    thumb_buffer = BytesIO()
    image_format = image.format if image.format else "JPEG"

    if image_format.upper() in ["JPEG", "JPG"] and image.mode in ("RGBA", "P"):
        image = image.convert("RGB")

    image.save(thumb_buffer, format=image_format)
    thumb_buffer.seek(0)

    thumbnail_key = f"thumbnails/{file_name}"

    s3.put_object(
        Bucket=bucket_name,
        Key=thumbnail_key,
        Body=thumb_buffer,
        ContentType="image/jpeg"
    )

    print(f"Thumbnail created: {thumbnail_key}")

    return thumbnail_key


def generate_basic_tags(file_name):
    name_without_ext = file_name.rsplit(".", 1)[0].lower()
    words = re.split(r"[_\-\s\d]+", name_without_ext)
    words = [word for word in words if word and len(word) > 1]

    tags = {}

    for word in words:
        tags[word] = tags.get(word, 0) + 1

    tags["unknown"] = 1
    return tags


def convert_floats_to_decimal(obj):
    if isinstance(obj, float):
        return Decimal(str(obj))

    if isinstance(obj, dict):
        return {
            key: convert_floats_to_decimal(value)
            for key, value in obj.items()
        }

    if isinstance(obj, list):
        return [
            convert_floats_to_decimal(value)
            for value in obj
        ]

    return obj


def call_oracle_species_detector(file_name, file_type, image_bytes):
    image_base64 = base64.b64encode(image_bytes).decode("utf-8")

    payload = {
        "file_name": file_name,
        "file_type": file_type,
        "image_base64": image_base64
    }

    data = json.dumps(payload).encode("utf-8")

    request = urllib.request.Request(
        ORACLE_DETECT_URL,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST"
    )

    try:
        print(f"Calling Oracle image ML endpoint: {ORACLE_DETECT_URL}")
        print(f"Sending image file_name to Oracle: {file_name}")

        with urllib.request.urlopen(request, timeout=90) as response:
            response_body = response.read().decode("utf-8")
            result = json.loads(response_body)

        print("Oracle image ML response:")
        print(json.dumps(result, indent=2))

        tags = result.get("tags", {})
        confidence = result.get("confidence", {})
        source = result.get("source", "Oracle ML detection")

        if tags:
            return tags, confidence, source

        print("Oracle image response did not include tags. Falling back to basic tags.")
        return generate_basic_tags(file_name), {}, "fallback_basic_tags"

    except Exception as e:
        print(f"Oracle image ML detection failed: {str(e)}")
        print("Falling back to basic tags.")
        return generate_basic_tags(file_name), {}, "fallback_basic_tags"


def call_oracle_video_detector(file_name, file_type, video_bytes):
    video_base64 = base64.b64encode(video_bytes).decode("utf-8")

    payload = {
