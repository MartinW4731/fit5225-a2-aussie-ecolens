import json
import boto3
import base64
import urllib.request
from decimal import Decimal

dynamodb = boto3.resource("dynamodb")
table = dynamodb.Table("AussieEcoLensMedia")
s3 = boto3.client("s3")

ORACLE_DETECT_URL = "http://158.179.17.163:8080/detect"
ORACLE_VIDEO_DETECT_URL = "http://158.179.17.163:8080/detect-video"


def decimal_default(obj):
    if isinstance(obj, Decimal):
        return int(obj)
    raise TypeError


def parse_s3_url(s3_url):
    if not s3_url or not s3_url.startswith("s3://"):
        return None, None

    without_scheme = s3_url.replace("s3://", "", 1)
    parts = without_scheme.split("/", 1)

    if len(parts) != 2:
        return None, None

    return parts[0], parts[1]


def generate_presigned_url(s3_url, expires_in=3600):
    bucket, key = parse_s3_url(s3_url)

    if not bucket or not key:
        return None

    try:
        return s3.generate_presigned_url(
            ClientMethod="get_object",
            Params={
                "Bucket": bucket,
                "Key": key
            },
            ExpiresIn=expires_in
        )
    except Exception as e:
        print(f"Failed to generate presigned URL for {s3_url}: {str(e)}")
        return None


def call_oracle_image_detector(file_name, file_type, image_base64):
    payload = {
        "file_name": file_name,
        "file_type": file_type,
        "image_base64": image_base64
    }

    data = json.dumps(payload).encode("utf-8")

    request = urllib.request.Request(
        ORACLE_DETECT_URL,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST"
    )

    with urllib.request.urlopen(request, timeout=90) as response:
        response_body = response.read().decode("utf-8")
        result = json.loads(response_body)

    print("Oracle image ML response:")
    print(json.dumps(result, indent=2))

    return result


def call_oracle_video_detector(file_name, file_type, video_base64):
    payload = {
        "file_name": file_name,
        "file_type": file_type,
        "video_base64": video_base64
