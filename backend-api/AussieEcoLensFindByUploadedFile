import json
import boto3
import urllib.request
import urllib.error
from decimal import Decimal

dynamodb = boto3.resource("dynamodb")
table = dynamodb.Table("AussieEcoLensMedia")
s3 = boto3.client("s3")

ORACLE_IMAGE_DETECT_URL = "http://169.224.229.232:8080/detect"
ORACLE_VIDEO_DETECT_URL = "http://169.224.229.232:8080/detect-video"


def decimal_default(obj):
    if isinstance(obj, Decimal):
        if obj % 1 == 0:
            return int(obj)
        return float(obj)
    raise TypeError


def convert_decimal(obj):
    if isinstance(obj, list):
        return [convert_decimal(value) for value in obj]

    if isinstance(obj, dict):
        return {key: convert_decimal(value) for key, value in obj.items()}

    if isinstance(obj, Decimal):
        if obj % 1 == 0:
            return int(obj)
        return float(obj)

    return obj


def parse_s3_url(s3_url):
    if not s3_url or not s3_url.startswith("s3://"):
        return None, None

    without_scheme = s3_url.replace("s3://", "", 1)
    parts = without_scheme.split("/", 1)

    if len(parts) != 2:
        return None, None

    return parts[0], parts[1]


def generate_presigned_url(s3_url, expires_in=3600):
    bucket, key = parse_s3_url(s3_url)

    if not bucket or not key:
        return None

    try:
        return s3.generate_presigned_url(
            ClientMethod="get_object",
            Params={
                "Bucket": bucket,
                "Key": key
            },
            ExpiresIn=expires_in
        )
    except Exception as e:
        print(f"Failed to generate presigned URL for {s3_url}: {str(e)}")
        return None


def post_json_to_oracle(url, payload, timeout=180):
    body = json.dumps(payload).encode("utf-8")

    request = urllib.request.Request(
        url=url,
        data=body,
        headers={
            "Content-Type": "application/json"
        },
        method="POST"
    )

    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            response_body = response.read().decode("utf-8")
            return json.loads(response_body)

    except urllib.error.HTTPError as e:
        error_body = e.read().decode("utf-8")
        raise Exception(f"Oracle HTTP error {e.code}: {error_body}")

    except urllib.error.URLError as e:
        raise Exception(f"Oracle request failed: {str(e)}")


def call_oracle_image(image_base64, file_name):
    print(f"Calling Oracle image ML endpoint: {ORACLE_IMAGE_DETECT_URL}")
    print(f"Sending query image base64 to Oracle: {file_name}")

    return post_json_to_oracle(
        ORACLE_IMAGE_DETECT_URL,
        {
            "file_name": file_name,
            "image_base64": image_base64
        },
        timeout=120
    )


def call_oracle_video(video_base64, file_name):
    print(f"Calling Oracle video ML endpoint: {ORACLE_VIDEO_DETECT_URL}")
    print(f"Sending query video base64 to Oracle: {file_name}")

    return post_json_to_oracle(
        ORACLE_VIDEO_DETECT_URL,
        {
            "file_name": file_name,
            "video_base64": video_base64
        },
        timeout=180
    )


def scan_matching_media(detected_tags):
    response = table.scan()
    items = response.get("Items", [])

    while "LastEvaluatedKey" in response:
        response = table.scan(
            ExclusiveStartKey=response["LastEvaluatedKey"]
        )
        items.extend(response.get("Items", []))

    matched_results = []

    for item in items:
        item_tags = convert_decimal(item.get("tags", {}))

        matched = False

        for tag in detected_tags.keys():
            if int(item_tags.get(tag, 0)) > 0:
                matched = True
                break

        if matched:
            file_url = item.get("file_url")
            thumbnail_url = item.get("thumbnail_url")
            frames_processed = convert_decimal(item.get("frames_processed", 0))

            matched_results.append({
                "file_id": item.get("file_id"),
                "file_name": item.get("file_name"),
                "file_type": item.get("file_type"),
                "file_url": file_url,
                "thumbnail_url": thumbnail_url,
                "file_presigned_url": generate_presigned_url(file_url),
                "thumbnail_presigned_url": generate_presigned_url(thumbnail_url),
                "tags": item_tags,
                "confidence": convert_decimal(item.get("confidence", {})),
                "frames_processed": int(frames_processed or 0),
                "ml_source": item.get("ml_source", "")
            })

    return matched_results


def lambda_handler(event, context):
    print("Received event:")
    print(json.dumps(event, indent=2)[:2000])

    try:
        if "body" in event and event["body"]:
            body = json.loads(event["body"])
        else:
            body = event

        file_name = body.get("file_name", "query-file")
        file_type = body.get("file_type", "image")

        if file_type == "image":
            image_base64 = body.get("image_base64")

            if not image_base64:
                return response_json(400, {
                    "message": "Missing image_base64 for image query."
                })

            oracle_result = call_oracle_image(image_base64, file_name)

        elif file_type == "video":
            video_base64 = body.get("video_base64")

            if not video_base64:
                return response_json(400, {
                    "message": "Missing video_base64 for video query."
                })

            oracle_result = call_oracle_video(video_base64, file_name)

        else:
            return response_json(400, {
                "message": "Unsupported file_type. Use image or video.",
                "file_type": file_type
            })

        print("Oracle ML response:")
        print(json.dumps(oracle_result, indent=2, default=decimal_default))

        detected_tags = convert_decimal(oracle_result.get("tags", {}))
        confidence = convert_decimal(oracle_result.get("confidence", {}))
        frames_processed = convert_decimal(oracle_result.get("frames_processed", 0))
        source = oracle_result.get("source", "Oracle ML detection")

        if not detected_tags:
            return response_json(200, {
                "message": "Uploaded query file processed, but no species tags were detected.",
                "uploaded_file_name": file_name,
                "uploaded_file_type": file_type,
                "detected_tags": {},
                "confidence": confidence,
                "frames_processed": int(frames_processed or 0),
                "source": source,
                "count": 0,
                "results": []
            })

        matched_results = scan_matching_media(detected_tags)

        return response_json(200, {
            "message": "Uploaded file detected and matching media returned.",
            "uploaded_file_name": file_name,
            "uploaded_file_type": file_type,
            "detected_tags": detected_tags,
            "confidence": confidence,
            "frames_processed": int(frames_processed or 0),
            "source": source,
            "count": len(matched_results),
            "results": matched_results
        })

    except Exception as e:
        print("Error:", str(e))

        return response_json(500, {
            "message": "Uploaded file search failed.",
            "error": str(e)
        })


def response_json(status_code, body):
    return {
        "statusCode": status_code,
        "headers": {
            "Content-Type": "application/json",
            "Access-Control-Allow-Origin": "*",
            "Access-Control-Allow-Headers": "Content-Type,Authorization",
            "Access-Control-Allow-Methods": "POST,OPTIONS"
        },
        "body": json.dumps(body, default=decimal_default)
    }
