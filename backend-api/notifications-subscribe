import json
import boto3
from datetime import datetime, timezone

dynamodb = boto3.resource("dynamodb")
sns = boto3.client("sns")

TABLE_NAME = "AussieEcoLensSubscriptions"
SNS_TOPIC_ARN = "arn:aws:sns:ap-southeast-2:656260749390:AussieEcoLensTagNotifications"

table = dynamodb.Table(TABLE_NAME)


def normalise_tag(tag):
    """
    Convert user input into the same format as Oracle ML tags.
    Example:
    Bos Taurus -> bos_taurus
    Bos_taurus -> bos_taurus
    """
    return str(tag or "").strip().lower().replace(" ", "_")


def find_email_subscription(email):
    """
    Find an existing SNS email subscription for this email address.
    """
    next_token = None

    while True:
        kwargs = {
            "TopicArn": SNS_TOPIC_ARN
        }

        if next_token:
            kwargs["NextToken"] = next_token

        response = sns.list_subscriptions_by_topic(**kwargs)

        print("SNS subscriptions page:")
        print(json.dumps(response, indent=2, default=str))

        for sub in response.get("Subscriptions", []):
            if (
                sub.get("Protocol") == "email"
                and sub.get("Endpoint", "").lower() == email.lower()
            ):
                subscription_arn = sub.get("SubscriptionArn")

                if subscription_arn == "Deleted":

                    print("Found deleted SNS subscription. Ignoring it and creating a new one.")

                    continue

                print("Existing SNS subscription found:")

                print(json.dumps(sub, indent=2, default=str))

                return sub

        next_token = response.get("NextToken")

        if not next_token:
            break

    print(f"No existing SNS subscription found for {email}")
    return None


def ensure_sns_subscription(email, tags):
    """
    Create SNS email subscription if missing.
    If the subscription is already confirmed, update its filter policy.
    """
    existing = find_email_subscription(email)

    if not existing:
        print(f"Creating new SNS email subscription for {email}")

        sub_response = sns.subscribe(
            TopicArn=SNS_TOPIC_ARN,
            Protocol="email",
            Endpoint=email,
            ReturnSubscriptionArn=True
        )

        print("SNS subscribe response:")
        print(json.dumps(sub_response, indent=2, default=str))

        subscription_arn = sub_response.get("SubscriptionArn")

        return {
            "status": "subscription_created",
            "subscription_arn": subscription_arn,
            "message": "SNS subscription created. User must confirm the SNS email subscription before receiving notifications."
        }

    subscription_arn = existing.get("SubscriptionArn")

    print(f"Existing subscription ARN: {subscription_arn}")

    if not subscription_arn or not str(subscription_arn).startswith("arn:"):
        return {
        "status": "pending_confirmation",
        "subscription_arn": subscription_arn,
        "message": "SNS subscription is pending confirmation or not fully active yet. Please confirm the SNS email first, then try saving again after 1-2 minutes."
    }

    # If user unsubscribes from all tags, set a filter that will not match real species tags.
    filter_tags = tags if tags else ["__none__"]

    filter_policy = {
        "species_tag": filter_tags
    }

    print("Setting SNS filter policy:")
    print(json.dumps(filter_policy, indent=2))

    sns.set_subscription_attributes(
        SubscriptionArn=subscription_arn,
        AttributeName="FilterPolicy",
        AttributeValue=json.dumps(filter_policy)
    )

    return {
        "status": "filter_policy_updated",
        "subscription_arn": subscription_arn,
        "filter_policy": filter_policy
    }


def lambda_handler(event, context):
    print("Received event:")
    print(json.dumps(event, indent=2, default=str))

    try:
        body = json.loads(event.get("body") or "{}")

        user_email = body.get("user_email")
        subscribed_tags = body.get("subscribed_tags", [])

        if not user_email:
            return make_response(400, {
                "error": "user_email is required"
            })

        if not isinstance(subscribed_tags, list):
            return make_response(400, {
                "error": "subscribed_tags must be a list"
            })

        clean_tags = []

        for tag in subscribed_tags:
            tag = normalise_tag(tag)

            if tag and tag not in clean_tags:
                clean_tags.append(tag)

        item = {
            "user_email": user_email,
            "subscribed_tags": clean_tags,
            "updated_at": datetime.now(timezone.utc).isoformat()
        }

        print("Saving notification preference item to DynamoDB:")
        print(json.dumps(item, indent=2, default=str))

        table.put_item(Item=item)

        sns_result = ensure_sns_subscription(user_email, clean_tags)

        print("SNS result:")
        print(json.dumps(sns_result, indent=2, default=str))

        return make_response(200, {
            "message": "Notification preferences saved successfully.",
            "user_email": user_email,
            "subscribed_tags": clean_tags,
            "sns_result": sns_result
        })

    except Exception as e:
        print("Error saving notification preferences:")
        print(str(e))

        return make_response(500, {
            "error": str(e)
        })


def make_response(status_code, body):
    return {
        "statusCode": status_code,
        "headers": {
            "Access-Control-Allow-Origin": "*",
            "Access-Control-Allow-Headers": "Content-Type,Authorization",
            "Access-Control-Allow-Methods": "OPTIONS,POST"
        },
        "body": json.dumps(body, default=str)
    }
