import json
import os
import boto3
from decimal import Decimal

dynamodb = boto3.resource("dynamodb")
table = dynamodb.Table(os.environ.get("TABLE_NAME", "AussieEcoLensMedia"))

def decimal_default(obj):
    """Convert DynamoDB Decimal values into JSON-safe Python numbers."""
    if isinstance(obj, Decimal):
        # Preserve integer-looking values as int, but keep fractional values as float.
        if obj % 1 == 0:
            return int(obj)
        return float(obj)
    raise TypeError

def get_thumbnail_url(body):
    """Read the thumbnail value from any supported request field alias."""
    return (
        body.get("thumbnail_url")
        or body.get("thumbnailUrl")
        or body.get("thumbnail")
    )

def lambda_handler(event, context):
    print("Received event:")
    print(json.dumps(event, indent=2))

    try:
        # API Gateway usually sends request JSON inside body as a string.
        if "body" in event and event["body"]:
            body = json.loads(event["body"])
        else:
            body = event

        # Supported request aliases:
        # {"thumbnail_url": "..."}
        # {"thumbnailUrl": "..."}
        # {"thumbnail": "..."}
        thumbnail_url = get_thumbnail_url(body)

        if not thumbnail_url:
            return {
                "statusCode": 400,
                "headers": {
                    "Content-Type": "application/json",
                    "Access-Control-Allow-Origin": "*"
                },
                "body": json.dumps({
                    "message": "Missing thumbnail_url. Please provide {'thumbnail_url': 's3://.../thumbnails/example.JPG'}"
                })
            }

        response = table.scan()
        items = response.get("Items", [])

        # Continue scanning until all DynamoDB pages have been read.
        while "LastEvaluatedKey" in response:
            response = table.scan(ExclusiveStartKey=response["LastEvaluatedKey"])
            items.extend(response.get("Items", []))

        for item in items:
            if item.get("thumbnail_url") == thumbnail_url:
                return {
                    "statusCode": 200,
                    "headers": {
                        "Content-Type": "application/json",
                        "Access-Control-Allow-Origin": "*"
                    },
                    "body": json.dumps({
                        "thumbnail_url": thumbnail_url,
                        # Return the matching full-size image URL.
                        "file_url": item.get("file_url"),
                        "file_name": item.get("file_name"),
                        "file_type": item.get("file_type"),
                        "tags": item.get("tags", {})
                    }, default=decimal_default)
                }

        return {
            "statusCode": 404,
            "headers": {
                "Content-Type": "application/json",
                "Access-Control-Allow-Origin": "*"
            },
            "body": json.dumps({
                "message": "No image found for this thumbnail_url",
                "thumbnail_url": thumbnail_url
            })
        }

    except Exception as e:
        print("Error:", str(e))

        return {
            "statusCode": 500,
            "headers": {
                "Content-Type": "application/json",
                "Access-Control-Allow-Origin": "*"
            },
            "body": json.dumps({
                "message": "Query failed",
                "error": str(e)
            })
        }
